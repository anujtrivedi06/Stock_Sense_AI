import sys
import re
from collections import defaultdict, Counter

def get_stats(vocab):
    """Count frequency of adjacent byte pairs in vocabulary"""
    pairs = defaultdict(int)
    for word, freq in vocab.items():
        symbols = word.split()
        for i in range(len(symbols) - 1):
            pairs[symbols[i], symbols[i + 1]] += freq
    return pairs

def merge_vocab(pair, vocab):
    """Merge the most frequent pair in vocabulary"""
    bigram = ' '.join(pair)
    replacement = ''.join(pair)
    
    new_vocab = {}
    pattern = re.escape(bigram)
    
    for word, freq in vocab.items():
        new_word = re.sub(pattern, replacement, word)
        new_vocab[new_word] = freq
    
    return new_vocab

def get_vocabulary(corpus):
    """Build initial vocabulary from corpus with character-level tokens"""
    vocab = defaultdict(int)
    
    for line in corpus:
        line = line.strip()
        if not line:
            continue
        
        # Split line into words
        words = line.split()
        
        for word in words:
            # Add end-of-word marker and space characters between letters
            word_chars = ' '.join(list(word)) + ' </w>'
            vocab[word_chars] += 1
    
    return vocab

def learn_bpe(corpus, num_merges):
    """Learn BPE merges from corpus"""
    # Build initial vocabulary
    vocab = get_vocabulary(corpus)
    
    merges = []
    
    # Perform num_merges iterations
    for i in range(num_merges):
        pairs = get_stats(vocab)
        
        if not pairs:
            break
        
        # Find most frequent pair
        best_pair = max(pairs, key=pairs.get)
        
        # Merge the best pair
        vocab = merge_vocab(best_pair, vocab)
        merges.append(best_pair)
    
    return merges, vocab

def get_tokens_from_vocab(vocab):
    """Extract all unique tokens from the final vocabulary"""
    tokens = set()
    
    for word in vocab.keys():
        for token in word.split():
            tokens.add(token)
    
    return sorted(list(tokens))

def main():
    if len(sys.argv) != 2:
        print("Usage: python RollNumber_prob2.py corpus.txt")
        sys.exit(1)
    
    corpus_file = sys.argv[1]
    
    # Read corpus
    try:
        with open(corpus_file, 'r', encoding='utf-8') as f:
            corpus = f.readlines()
    except FileNotFoundError:
        print(f"Error: File '{corpus_file}' not found")
        sys.exit(1)
    
    # Get number of merges from user
    try:
        num_merges = int(input("Enter number of merges K: "))
    except ValueError:
        print("Error: Number of merges must be an integer")
        sys.exit(1)
    
    if num_merges < 0:
        print("Error: Number of merges must be non-negative")
        sys.exit(1)
    
    # Learn BPE
    merges, final_vocab = learn_bpe(corpus, num_merges)
    
    # Get vocabulary (all unique tokens)
    vocabulary = get_tokens_from_vocab(final_vocab)
    
    # Print results
    print("\nLearned Merges:")
    for i, (a, b) in enumerate(merges, 1):
        print(f"{i}. ({a}, {b}) -> {a}{b}")
    
    print(f"\nFinal Vocabulary (size: {len(vocabulary)}):")
    print(vocabulary)

if __name__ == "__main__":
    main()